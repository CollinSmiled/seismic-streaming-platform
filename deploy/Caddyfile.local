{
	admin off
	auto_https off
}

http://:8080 {
	@api path /api/v1/* /health /ready
	handle @api {
		reverse_proxy api:8000
	}
	@private path /metrics /docs /redoc /openapi.json
	handle @private {
		respond 404
	}
	handle {
		root * /srv
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}

http://:8082 {
	import /run/secrets/grafana_gateway_auth
	reverse_proxy grafana:3000 {
		header_up -Authorization
	}
}

http://127.0.0.1:8081 {
	respond /health "ok" 200
}
