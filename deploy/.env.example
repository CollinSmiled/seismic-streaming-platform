# Use a separate .env file with docker compose --env-file deploy/.env -f deploy/compose.yaml.
APP_DOMAIN=seismic.localhost
GRAFANA_DOMAIN=grafana.localhost
TLS_ISSUER=internal
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
BACKEND_IMAGE=seismic-backend:local
WEB_IMAGE=seismic-web:local
# This public value is compiled into the frontend. Restrict it to the deployed URL.
VITE_MAPBOX_ACCESS_TOKEN=
# Paths are relative to deploy/ unless absolute.
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres_admin_password
GRAFANA_ADMIN_PASSWORD_FILE=./secrets/grafana_admin_password
GRAFANA_SECRET_KEY_FILE=./secrets/grafana_secret_key
GRAFANA_GATEWAY_AUTH_FILE=./secrets/grafana_gateway_auth
